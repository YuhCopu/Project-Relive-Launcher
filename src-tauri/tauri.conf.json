{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Project Relive",
    "version":  "1.1.2",
    "identifier":  "com.projectrelive.launcher",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "plugins":  {
                    "deep-link":  {
                                      "desktop":  {
                                                      "schemes":  [
                                                                      "projectrelive"
                                                                  ]
                                                  }
                                  },
                    "updater":  {
                                    "pubkey":  "",
                                    "endpoints":  [

                                                  ]
                                }
                },
    "app":  {
                "windows":  [
                                {
                                    "title":  "Project Relive",
                                    "width":  1100,
                                    "height":  640,
                                    "minHeight":  640,
                                    "minWidth":  1100,
                                    "decorations":  false,
                                    "fullscreen":  false,
                                    "resizable":  true,
                                    "center":  true,
                                    "transparent":  true
                                }
                            ],
                "security":  {
                                 "assetProtocol":  {
                                                       "scope":  [
                                                                     "*/**"
                                                                 ],
                                                       "enable":  true
                                                   },
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "createUpdaterArtifacts":  false,
                   "icon":  [
                                "icons/icon.png",
                                "icons/icon.ico",
                                "icons/icon.icns"
                            ]
               }
}
